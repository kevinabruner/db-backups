[global]
repo1-path=/var/lib/pgbackrest
repo1-retention-full=2
process-max=4
compress-type=lz4
start-fast=y
log-level-console=info
log-level-file=debug
repo1-s3-region=ca-central-1

[db]
{% for host in active_dbs %}
pg{{ loop.index }}-path={{ hostvars[host].postgresql_data_dir | default('/var/lib/postgresql/17/main') }}
pg{{ loop.index }}-host={{ hostvars[host].ansible_host | default(host) }}
pg{{ loop.index }}-user=postgres
{% endfor %}